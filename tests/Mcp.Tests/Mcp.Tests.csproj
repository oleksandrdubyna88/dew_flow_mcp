<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mcp.Contracts\Mcp.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Application\Mcp.Application.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Server\Mcp.Server.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Bridge\Mcp.Bridge.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Telemetry\Mcp.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Api\Mcp.Api.csproj" />
    <ProjectReference Include="..\..\src\Mcp.Ui\Mcp.Ui.csproj" />
    <ProjectReference Include="..\..\src\Workspace.Application\Workspace.Application.csproj" />
    <ProjectReference Include="..\..\src\Workspace.Infrastructure\Workspace.Infrastructure.csproj" />
    <!-- ServiceDefaults had no tests at all, which is how the console sink's per-line flush and the
         log's unbounded run file both survived to the 24/7 audit. Referenced deliberately, not
         incidentally: the two sinks below have real behaviour — where a line goes, and how many writes
         it costs — and neither is observable from any other project. -->
    <ProjectReference Include="..\..\src\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 8 test threads (common.local-cpu-budget). The file must reach the output folder:
         measured 2026-10-11 on xunit.v3 4.0.1, an uncopied xunit.runner.json is never read and the
         runner takes one thread per CPU (24). A command-line max-threads switch still overrides it.
         Not on CI: maxParallelThreads is an exact number, so a 4-vCPU runner would be RAISED to 8. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(CI)' != 'true'" />
  </ItemGroup>

</Project>
