<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- MCP's own console pages and settings screen. A Razor class library, WASM-compatible:
       it is mounted by a Blazor SSR host running its interactivity in WebAssembly. -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- The one call a host makes is AddMcpUi(); the abstractions are what lets this library register
         its own services without knowing which container it lands in. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mcp.Contracts\Mcp.Contracts.csproj" />
  </ItemGroup>

</Project>
