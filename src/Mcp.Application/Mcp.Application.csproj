<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tool catalog, sandbox policy, call logging, usage metering. Knows nothing about retrieval:
       the architecture test fails the build if anything here ever names a Rag type. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mcp.Contracts\Mcp.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolSurfaceProvider is internal on purpose: it is a decorator this module applies, never a type
         a host composes. The suite still asserts its refusal directly, because reaching it through DI
         would only prove the wiring. -->
    <InternalsVisibleTo Include="Mcp.Tests" />
  </ItemGroup>

</Project>
